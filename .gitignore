# Secrets — never commit real credentials
secrets/**/*.env
secrets/**/*.key
secrets/**/*.pem
secrets/**/*.json
secrets/**/credentials*
secrets/**/password*
secrets/**/account.env
secrets/**/bybit.env
!secrets/**/*.example
!secrets/**/README.md
!secrets/**/.gitkeep

# Common env / secret patterns
.env
.env.*
!.env.example

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/settings.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# Market data cache & run artifacts
data/cache/
artifacts/
