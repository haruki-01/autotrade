# Bybit LIVE / Mainnet
# Copy to bybit.env and fill in real values:
#   cp secrets/live/bybit.env.example secrets/live/bybit.env
#
# WARNING: This is real-money credentials.
# - No withdraw permission
# - Separate key from demo
# - Enable IP allowlist on Bybit

BYBIT_ENV=live
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Mainnet REST base URL
BYBIT_BASE_URL=https://api.bybit.com

# Optional notes (do not put passwords here if avoidable)
# BYBIT_ACCOUNT_EMAIL=
# NOTES=
