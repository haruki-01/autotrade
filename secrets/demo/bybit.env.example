# Bybit DEMO / Testnet
# Copy to bybit.env and fill in real values:
#   cp secrets/demo/bybit.env.example secrets/demo/bybit.env

BYBIT_ENV=demo
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Optional: override REST base URL if needed
# Testnet example: https://api-testnet.bybit.com
BYBIT_BASE_URL=https://api-testnet.bybit.com

# Optional notes (do not put passwords here if avoidable)
# BYBIT_ACCOUNT_EMAIL=
# NOTES=
