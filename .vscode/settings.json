{
  // Editor layout: Explorer left, editor center, Agent/Chat right.
  // In Cursor, sideBar "left" maps to Editor layout (not Agent layout).
  "workbench.sideBar.location": "left",
  "workbench.activityBar.location": "default",
  "workbench.panel.defaultLocation": "bottom",
  "workbench.editor.openSideBySideDirection": "right",
  "explorer.autoReveal": true,
  "explorer.excludeGitIgnore": false,
  "search.useIgnoreFiles": false,
  "search.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "data/cache": true,
    "artifacts": true,
    ".venv": true,
    "venv": true
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "data/cache": true,
    "artifacts": true
  }
}
